              "\r",
              "}\r",
              "\r",
              "const dataset= [\"Ceramic Candy Bowl - Black\" , \"Stainless Steel Thermos - Yellow\", \"Desk Pen Holder - Yellow\"];\r",
              "const randomNumber = getRandomArbitrary(0,2);\r",
              "const searchText = dataset[randomNumber];\r",
              "pm.collectionVariables.set(\"searched_text\",searchText);"
            ],
